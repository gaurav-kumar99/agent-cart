# EVERYTHING IS OPTIONAL. With no keys the app runs in demo mode (scripted AI, fake PayPal page).

# Free AI (get a key at https://aistudio.google.com/apikey):
GEMINI_API_KEY=

# OR Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Real PayPal sandbox (free): developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

PORT=3000
